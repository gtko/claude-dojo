<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tests unitaires maison (sans framework ni NuGet) : exe console qui retourne 0 si tout passe. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>DojoWallpaper.Tests</AssemblyName>
    <RootNamespace>DojoWallpaper.Tests</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <BaseOutputPath>build\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- Code testé : fichiers de src\ inclus directement, pas de projet référencé. -->
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\..\src\DojoConfig.cs">
      <Link>src\DojoConfig.cs</Link>
    </Compile>
    <Compile Include="..\..\src\PauseLogic.cs">
      <Link>src\PauseLogic.cs</Link>
    </Compile>
    <Compile Include="..\..\src\ConfigWatcher.cs">
      <Link>src\ConfigWatcher.cs</Link>
    </Compile>
    <Compile Include="..\..\src\Autostart.cs">
      <Link>src\Autostart.cs</Link>
    </Compile>
    <Compile Include="..\..\src\TrayController.cs">
      <Link>src\TrayController.cs</Link>
    </Compile>
    <Compile Include="..\..\src\DojoLog.cs">
      <Link>src\DojoLog.cs</Link>
    </Compile>
    <Compile Include="..\..\src\ScreenHitTest.cs">
      <Link>src\ScreenHitTest.cs</Link>
    </Compile>
    <Compile Include="..\..\src\SafeArea.cs">
      <Link>src\SafeArea.cs</Link>
    </Compile>
    <!-- InputForwarder utilise DesktopNative (defini dans DesktopHost.cs) : les deux sont compiles ensemble. -->
    <Compile Include="..\..\src\DesktopHost.cs">
      <Link>src\DesktopHost.cs</Link>
    </Compile>
    <Compile Include="..\..\src\InputForwarder.cs">
      <Link>src\InputForwarder.cs</Link>
    </Compile>
    <!-- Pont WebView2 : logique pure (liste blanche, lancement de node, dispatch). La fenetre (UiWindow.cs) n'est pas testee ici. -->
    <Compile Include="..\..\src\BridgeCommands.cs">
      <Link>src\BridgeCommands.cs</Link>
    </Compile>
    <Compile Include="..\..\src\NodeLocator.cs">
      <Link>src\NodeLocator.cs</Link>
    </Compile>
    <Compile Include="..\..\src\NodeRunner.cs">
      <Link>src\NodeRunner.cs</Link>
    </Compile>
    <Compile Include="..\..\src\UiLayout.cs">
      <Link>src\UiLayout.cs</Link>
    </Compile>
    <Compile Include="..\..\src\UiBridge.cs">
      <Link>src\UiBridge.cs</Link>
    </Compile>
  </ItemGroup>

</Project>
