<Project Sdk="Microsoft.NET.Sdk">

  <!-- Sonde console : journalise chaque transition de PauseEngine (preuve de detection, hors csproj principal). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AssemblyName>PauseProbe</AssemblyName>
    <RootNamespace>PauseProbe</RootNamespace>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <BaseOutputPath>build\</BaseOutputPath>
    <BaseIntermediateOutputPath>obj\</BaseIntermediateOutputPath>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <!-- Code teste : fichiers de src\ inclus directement. -->
  <ItemGroup>
    <Compile Include="..\..\src\DojoConfig.cs">
      <Link>src\DojoConfig.cs</Link>
    </Compile>
    <Compile Include="..\..\src\PauseLogic.cs">
      <Link>src\PauseLogic.cs</Link>
    </Compile>
    <Compile Include="..\..\src\PauseEngine.cs">
      <Link>src\PauseEngine.cs</Link>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

</Project>
