{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "width": 30,
    "height": 12,
    "padding": {
      "top": 0,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;60;245;154",
      "output": "38;2;238;244;248"
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;60;245;154m◢◤ AGENCE DE HÉROS ◥◣\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;140;196;255m── Terminal du lycée · Plus Ultra ──\u001b[0m"
    },
    "break",
    {
      "type": "title",
      "key": "✦ élève      ",
      "format": "{user-name}"
    },
    {
      "type": "title",
      "key": "✦ lycée      ",
      "format": "{host-name}"
    },
    {
      "type": "os",
      "key": "✦ campus     ",
      "format": "{name} {version}"
    },
    {
      "type": "cpu",
      "key": "✦ quirk      ",
      "format": "{name} · {cores-physical} cœurs"
    },
    {
      "type": "memory",
      "key": "✦ énergie    "
    },
    {
      "type": "uptime",
      "key": "✦ patrouille "
    },
    // @DYNAMIC@
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;141;255;196m● énergie stable · Plus Ultra\u001b[0m"
    }
  ]
}
