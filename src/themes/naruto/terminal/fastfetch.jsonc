{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "width": 30,
    "height": 12,
    "padding": {
      "top": 0,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;242;140;40",
      "output": "38;2;248;248;242"
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;242;140;40m◢◤ DOJO DE KONOHA ◥◣\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;125;155;224m── Terminal du dojo · rang jōnin ──\u001b[0m"
    },
    "break",
    {
      "type": "title",
      "key": "✦ ninja      ",
      "format": "{user-name}"
    },
    {
      "type": "title",
      "key": "✦ village    ",
      "format": "{host-name}"
    },
    {
      "type": "os",
      "key": "✦ parchemin  ",
      "format": "{name} {version}"
    },
    {
      "type": "cpu",
      "key": "✦ chakra     ",
      "format": "{name} · {cores-physical} cœurs"
    },
    {
      "type": "memory",
      "key": "✦ réserve    "
    },
    {
      "type": "uptime",
      "key": "✦ en mission "
    },
    // @DYNAMIC@
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;143;207;106m● chakra stable · sceau verrouillé\u001b[0m"
    }
  ]
}
