{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "width": 30,
    "height": 12,
    "padding": {
      "top": 0,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;95;220;236",
      "output": "38;2;230;246;239"
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;95;220;236m◢◤ GUILDE DES MAGES ◥◣\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;127;192;239m── Terminal de l'académie · mana stable ──\u001b[0m"
    },
    "break",
    {
      "type": "title",
      "key": "✦ mage       ",
      "format": "{user-name}"
    },
    {
      "type": "title",
      "key": "✦ académie   ",
      "format": "{host-name}"
    },
    {
      "type": "os",
      "key": "✦ grimoire   ",
      "format": "{name} {version}"
    },
    {
      "type": "cpu",
      "key": "✦ mana       ",
      "format": "{name} · {cores-physical} cœurs"
    },
    {
      "type": "memory",
      "key": "✦ réserve    "
    },
    {
      "type": "uptime",
      "key": "✦ en service "
    },
    // @DYNAMIC@
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;143;242;196m● cercle scellé · sorts prêts\u001b[0m"
    }
  ]
}
