{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "width": 30,
    "height": 12,
    "padding": {
      "top": 0,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;247;214;112",
      "output": "38;2;244;241;230"
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;247;214;112m◢◤ GRAND LINE ◥◣\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;127;181;236m── Journal de bord · équipage pirate ──\u001b[0m"
    },
    "break",
    {
      "type": "title",
      "key": "✦ pirate    ",
      "format": "{user-name}"
    },
    {
      "type": "title",
      "key": "✦ navire    ",
      "format": "{host-name}"
    },
    {
      "type": "os",
      "key": "✦ carte     ",
      "format": "{name} {version}"
    },
    {
      "type": "cpu",
      "key": "✦ vigie     ",
      "format": "{name} · {cores-physical} cœurs"
    },
    {
      "type": "memory",
      "key": "✦ cale      "
    },
    {
      "type": "uptime",
      "key": "✦ traversée "
    },
    // @DYNAMIC@
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;138;217;168m● cap tenu · log pose calé\u001b[0m"
    }
  ]
}
