{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "width": 30,
    "height": 12,
    "padding": {
      "top": 0,
      "left": 2,
      "right": 4
    }
  },
  "display": {
    "separator": "  ",
    "color": {
      "keys": "38;2;226;189;122",
      "output": "38;2;238;240;250"
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;226;189;122m◢◤ VOYAGE DE FRIEREN ◥◣\u001b[0m"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;169;196;240m── Terminal de la mage · mille ans de grimoires ──\u001b[0m"
    },
    "break",
    {
      "type": "title",
      "key": "✦ mage      ",
      "format": "{user-name}"
    },
    {
      "type": "title",
      "key": "✦ forêt     ",
      "format": "{host-name}"
    },
    {
      "type": "os",
      "key": "✦ grimoire  ",
      "format": "{name} {version}"
    },
    {
      "type": "cpu",
      "key": "✦ mana      ",
      "format": "{name} · {cores-physical} cœurs"
    },
    {
      "type": "memory",
      "key": "✦ réserve   "
    },
    {
      "type": "uptime",
      "key": "✦ mille ans "
    },
    // @DYNAMIC@
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;168;220;180m✦ mana stable · cercle ouvert\u001b[0m"
    }
  ]
}
